# All VITE_* values are PUBLIC and inlined at build time — never put secrets here.
# Redeploy after changing them.

# Setting this enables the Audio tab (e.g. https://asr.example.org — must be HTTPS, CORS must allow
# this site). http://localhost or http://127.0.0.1 is accepted only in local dev builds; any other
# non-HTTPS value is treated as unset (Audio tab stays disabled, with a console warning).
VITE_ASR_URL=
# Optional kill switch: set to "false" to keep the Audio tab disabled even when VITE_ASR_URL is set.
VITE_ASR_ENABLED=
VITE_ASR_TIMEOUT_MS=45000
VITE_ASR_MAX_UPLOAD_MB=10
# Dev only (ignored in production builds): fake transcripts to try the audio UI without a backend.
VITE_ASR_MOCK=false

# Command parser: rules (built-in, default) | llm (future Qwen parser at VITE_NLU_URL)
VITE_NLU_ENGINE=rules
VITE_NLU_URL=
