# All VITE_* values are PUBLIC and inlined at build time — never put secrets here.
# Redeploy after changing them.

# Setting this enables the Audio tab (e.g. https://asr.example.org — must be HTTPS, CORS must allow
# this site). http://localhost or http://127.0.0.1 is accepted only in local dev builds; any other
# non-HTTPS value is treated as unset (Audio tab stays disabled, with a console warning).
VITE_ASR_URL=
# Optional kill switch: set to "false" to keep the Audio tab disabled even when VITE_ASR_URL is set.
VITE_ASR_ENABLED=
VITE_ASR_TIMEOUT_MS=45000
VITE_ASR_MAX_UPLOAD_MB=10
# Microphone processing (echo cancellation, noise suppression, auto gain). "false" = raw mic signal,
# closer to the training recordings; compare both when rehearsing a demo.
VITE_ASR_MIC_DSP=true
# Dev only (ignored in production builds): fake transcripts to try the audio UI without a backend.
VITE_ASR_MOCK=false

# Command parser: rules (built-in, default) | llm (future Qwen parser at VITE_NLU_URL)
VITE_NLU_ENGINE=rules
VITE_NLU_URL=

# ---- AI-invented moves (Qwen) -----------------------------------------------------------------
# SERVER-SIDE ONLY: set these in Vercel → Project → Settings → Environment Variables (or in
# .env.local for `npm run dev`). NEVER prefix them with VITE_ — that would publish the key.
# Without DASHSCOPE_API_KEY the feature is simply off and the robot behaves as before.
# Alibaba Cloud Model Studio (Singapore / international) API key:
DASHSCOPE_API_KEY=
# Your workspace endpoint is recommended (Model Studio console → API keys), e.g.
# https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
# Kill switch without removing the key:
MOTION_AI_ENABLED=true
# Optional: let the model "think" first (slower, sometimes better moves).
QWEN_THINKING=false
# Optional: other origins allowed to call /api/motion (comma-separated), e.g. a preview host.
MOTION_ALLOWED_ORIGINS=

# Dev only (ignored in production builds): canned AI moves (moonwalk, backflip, lộn nhào,
# nháy mắt) without any key.
VITE_MOTION_MOCK=false
